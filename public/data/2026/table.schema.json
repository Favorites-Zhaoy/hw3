{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/worldcup-data-table-v1.json",
  "title": "World Cup Data Lab JSON table envelope",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "table",
    "meta",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "table": {
      "type": "string",
      "minLength": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "row_count"
      ],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
